{
  "uid": "svcdesk-lab3",
  "title": "svcdesk - Knowledge-base search",
  "tags": [
    "svcdesk",
    "lab3"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "KB search - requests per second",
      "description": "All /kb/search responses, including errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\",http_route=\"/kb/search\"}[$__rate_interval]))",
          "legendFormat": "requests/s",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "KB search - server error ratio",
      "description": "Server errors divided by all requests. Availability budget: 1%. No requests means no ratio.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\",http_route=\"/kb/search\",http_response_status_code=~\"5..\"}[$__rate_interval]))) / (sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\",http_route=\"/kb/search\"}[$__rate_interval])))",
          "legendFormat": "5xx share",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "KB search - server latency",
      "description": "Server-side latency, including the kb-index wait. SLO threshold: 200 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"svcdesk\",http_route=\"/kb/search\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"svcdesk\",http_route=\"/kb/search\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"svcdesk\",http_route=\"/kb/search\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "KB search - responses within 200 ms",
      "description": "Latency SLI, all statuses included. Target: 99%; availability is assessed separately.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_bucket{job=\"svcdesk\",http_route=\"/kb/search\",le=\"0.2\"}[$__rate_interval])) / (sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\",http_route=\"/kb/search\"}[$__rate_interval])))",
          "legendFormat": "within 200 ms",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "KB search - availability burn rate",
      "description": "1x would consume the availability budget over 30 days. Alert thresholds: 14.4x and 6x in both windows.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\",http_route=\"/kb/search\",http_response_status_code=~\"5..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\",http_route=\"/kb/search\"}[5m]))) / 0.01",
          "legendFormat": "5m",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\",http_route=\"/kb/search\",http_response_status_code=~\"5..\"}[1h])) / sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\",http_route=\"/kb/search\"}[1h]))) / 0.01",
          "legendFormat": "1h",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\",http_route=\"/kb/search\",http_response_status_code=~\"5..\"}[30m])) / sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\",http_route=\"/kb/search\"}[30m]))) / 0.01",
          "legendFormat": "30m",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "(sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\",http_route=\"/kb/search\",http_response_status_code=~\"5..\"}[6h])) / sum(rate(http_server_request_duration_seconds_count{job=\"svcdesk\",http_route=\"/kb/search\"}[6h]))) / 0.01",
          "legendFormat": "6h",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "svcdesk - scrape availability",
      "description": "Prometheus scrape result, separate from the user-facing availability SLI.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"svcdesk\"}",
          "legendFormat": "up",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    }
  ]
}
